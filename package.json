{
  "name": "ai-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalogs": {
    "backend": {
      "convex": "^1.44.0",
      "convex-helpers": "^0.1.123"
    },
    "shared": {
      "@ai-sdk/deepseek": "^3.0.28",
      "@ai-sdk/google": "^4.0.44",
      "@ai-sdk/moonshotai": "^3.0.34",
      "@ai-sdk/openai": "^4.0.41",
      "@ai-sdk/openai-compatible": "^3.0.30",
      "@axiomhq/js": "^2.0.0",
      "@axiomhq/logging": "^0.4.0",
      "better-result": "^3.0.1",
      "@t3-oss/env-core": "^0.13.11",
      "@workos/authkit-session": "^0.7.1",
      "@workos-inc/node": "^10.10.0",
      "ai": "^7.0.64",
      "dedent": "^1.7.2",
      "jose": "^6.2.8",
      "zod": "^4.4.3"
    },
    "tooling": {
      "@oxlint/plugins": "1.78.0",
      "@types/bun": "1.3.14",
      "@types/node": "26.2.0",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "oxlint": "^1.78.0",
      "oxlint-tsgolint": "^7.0.2001",
      "typescript": "^7.0.2"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:convex": "bun run --cwd packages/backend dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "turbo run lint typecheck",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@vercel/config": "^0.6.1"
  },
  "overrides": {
    "srvx": "0.11.22"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:tooling",
    "@prettier/plugin-oxc": "^0.2.2",
    "@typescript/native-preview": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.10",
    "typescript": "catalog:tooling"
  },
  "trustedDependencies": []
}
