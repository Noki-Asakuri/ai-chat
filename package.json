{
  "name": "ai-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalogs": {
    "backend": {
      "convex": "^1.51.0",
      "convex-helpers": "^0.1.136"
    },
    "shared": {
      "@ai-sdk/deepseek": "^3.0.88",
      "@ai-sdk/google": "^4.0.122",
      "@ai-sdk/moonshotai": "^3.0.94",
      "@ai-sdk/openai": "^4.0.121",
      "@ai-sdk/openai-compatible": "^3.0.93",
      "@axiomhq/js": "^2.0.0",
      "@axiomhq/logging": "^0.4.1",
      "better-result": "^3.0.1",
      "@t3-oss/env-core": "^0.13.11",
      "@ui-sdk/core": "0.1.0-beta.13",
      "@ui-sdk/react": "0.1.0-beta.13",
      "@workos/authkit-session": "^0.9.1",
      "@workos-inc/node": "^11.0.0",
      "ai": "7.0.177",
      "dedent": "^1.7.2",
      "jose": "^6.2.18",
      "zod": "^4.6.7"
    },
    "tooling": {
      "@oxlint/plugins": "1.94.0",
      "@types/bun": "1.4.5",
      "@types/node": "26.6.6",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "oxlint": "^1.94.0",
      "oxlint-tsgolint": "^7.0.2007",
      "typescript": "^7.0.2"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:convex": "bun run --cwd packages/backend dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "turbo run lint typecheck",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@vercel/config": "^0.15.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:tooling",
    "@prettier/plugin-oxc": "^0.2.4",
    "@typescript/native-preview": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "catalog:tooling"
  },
  "trustedDependencies": []
}
